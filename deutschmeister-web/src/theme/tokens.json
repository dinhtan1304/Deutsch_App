{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/formats/json-schema.json",
  "meta": {
    "project": "Deutschmeister",
    "version": "1.0.0",
    "theme": "Dark Pastel Soft UI",
    "description": "Bold Dark base với Pastel Soft UI accents. Mỗi màu pastel có semantic role riêng, dùng 10% opacity làm tinted surface trên nền dark."
  },

  "color": {
    "base": {
      "b0": { "value": "#080810", "description": "App background - darkest" },
      "b1": { "value": "#0f0f1a", "description": "Page background" },
      "b2": { "value": "#16162a", "description": "Card / surface" },
      "b3": { "value": "#1e1e35", "description": "Input / nested surface" },
      "b4": { "value": "#252540", "description": "Hover / elevated surface" }
    },
    "pastel": {
      "lime": {
        "base":   { "value": "#c9f53b", "description": "Primary CTA - action only" },
        "dim":    { "value": "rgba(201, 245, 59, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#0a1400", "description": "Text on lime fill" }
      },
      "mint": {
        "base":   { "value": "#a8f0d0", "description": "Correct state, learned words" },
        "dim":    { "value": "rgba(168, 240, 208, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#052a1a", "description": "Text on mint fill" }
      },
      "lavender": {
        "base":   { "value": "#c4b5fd", "description": "Level, profile, active tab" },
        "dim":    { "value": "rgba(196, 181, 253, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#1a0a3a", "description": "Text on lavender fill" }
      },
      "sky": {
        "base":   { "value": "#a0d4ff", "description": "Noun 'der', info" },
        "dim":    { "value": "rgba(160, 212, 255, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#011a2a", "description": "Text on sky fill" }
      },
      "rose": {
        "base":   { "value": "#ffb3c6", "description": "Noun 'die', wrong state, SRS hot" },
        "dim":    { "value": "rgba(255, 179, 198, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#2a0010", "description": "Text on rose fill" }
      },
      "peach": {
        "base":   { "value": "#ffc9a0", "description": "XP reward, achievements, SRS warm" },
        "dim":    { "value": "rgba(255, 201, 160, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#2a1000", "description": "Text on peach fill" }
      }
    },
    "semantic": {
      "correct":      { "value": "{color.pastel.mint.base}" },
      "wrong":        { "value": "{color.pastel.rose.base}" },
      "xp":           { "value": "{color.pastel.peach.base}" },
      "level":        { "value": "{color.pastel.lavender.base}" },
      "cta":          { "value": "{color.pastel.lime.base}" },
      "noun-der":     { "value": "{color.pastel.sky.base}" },
      "noun-die":     { "value": "{color.pastel.rose.base}" },
      "noun-das":     { "value": "{color.pastel.mint.base}" }
    },
    "text": {
      "primary":      { "value": "#f0f0ff", "description": "Main text" },
      "secondary":    { "value": "rgba(240, 240, 255, 0.45)", "description": "Muted text" },
      "tertiary":     { "value": "rgba(240, 240, 255, 0.18)", "description": "Hint / placeholder" },
      "disabled":     { "value": "rgba(240, 240, 255, 0.25)" }
    },
    "border": {
      "subtle":       { "value": "rgba(255, 255, 255, 0.06)", "description": "Default card border" },
      "default":      { "value": "rgba(255, 255, 255, 0.10)", "description": "Emphasized border" },
      "strong":       { "value": "rgba(255, 255, 255, 0.18)", "description": "Focus / active border" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": { "value": "'SF Pro Display', 'Helvetica Neue', system-ui, sans-serif" },
      "mono": { "value": "'SF Mono', 'Fira Code', monospace" }
    },
    "fontSize": {
      "xs":   { "value": 10 },
      "sm":   { "value": 11 },
      "base": { "value": 13 },
      "md":   { "value": 15 },
      "lg":   { "value": 17 },
      "xl":   { "value": 22 },
      "word": { "value": 50, "description": "Vocab card big word" },
      "hero": { "value": 64, "description": "Streak hero number" }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 },
      "black":    { "value": 800 }
    },
    "lineHeight": {
      "tight":    { "value": 1.0 },
      "snug":     { "value": 1.3 },
      "normal":   { "value": 1.5 },
      "relaxed":  { "value": 1.7 }
    },
    "letterSpacing": {
      "tight":    { "value": -2 },
      "snug":     { "value": -0.5 },
      "normal":   { "value": 0 },
      "wide":     { "value": 0.5 },
      "widest":   { "value": 1.2, "description": "Uppercase labels" }
    }
  },

  "spacing": {
    "xs":   { "value": 4 },
    "sm":   { "value": 8 },
    "md":   { "value": 12 },
    "lg":   { "value": 16 },
    "xl":   { "value": 20 },
    "2xl":  { "value": 28 },
    "3xl":  { "value": 36 },
    "screen-h": { "value": 16, "description": "Horizontal screen padding" }
  },

  "borderRadius": {
    "sm":   { "value": 8 },
    "md":   { "value": 12 },
    "lg":   { "value": 14 },
    "xl":   { "value": 20 },
    "2xl":  { "value": 28, "description": "Hero cards, word card" },
    "pill": { "value": 999, "description": "Buttons, badges, nav" }
  },

  "component": {
    "statusBar":    { "height": { "value": 44 } },
    "bottomNav": {
      "height":         { "value": 56 },
      "borderRadius":   { "value": 999 },
      "background":     { "value": "{color.base.b2}" },
      "border":         { "value": "{color.border.default}" },
      "margin":         { "value": "8px 12px 12px" }
    },
    "card": {
      "background":     { "value": "{color.base.b2}" },
      "border":         { "value": "{color.border.default}" },
      "borderRadius":   { "value": "{borderRadius.xl}" },
      "padding":        { "value": "14px 16px" }
    },
    "heroCard": {
      "background":     { "value": "{color.base.b2}" },
      "accentBorder":   { "value": "rgba(201, 245, 59, 0.15)" },
      "borderRadius":   { "value": "{borderRadius.2xl}" },
      "padding":        { "value": "18px 20px" }
    },
    "button": {
      "primary": {
        "background":   { "value": "{color.pastel.lime.base}" },
        "color":        { "value": "{color.pastel.lime.on}" },
        "borderRadius": { "value": "{borderRadius.pill}" },
        "height":       { "value": 50 },
        "fontSize":     { "value": "{typography.fontSize.md}" },
        "fontWeight":   { "value": "{typography.fontWeight.black}" }
      },
      "ghost": {
        "background":   { "value": "{color.base.b2}" },
        "color":        { "value": "{color.text.secondary}" },
        "border":       { "value": "{color.border.default}" },
        "borderRadius": { "value": "{borderRadius.pill}" },
        "height":       { "value": 50 }
      }
    },
    "badge": {
      "genderDer": {
        "background":   { "value": "{color.pastel.sky.dim}" },
        "color":        { "value": "{color.pastel.sky.base}" },
        "border":       { "value": "rgba(160, 212, 255, 0.20)" }
      },
      "genderDie": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "color":        { "value": "{color.pastel.rose.base}" },
        "border":       { "value": "rgba(255, 179, 198, 0.20)" }
      },
      "genderDas": {
        "background":   { "value": "{color.pastel.mint.dim}" },
        "color":        { "value": "{color.pastel.mint.base}" },
        "border":       { "value": "rgba(168, 240, 208, 0.20)" }
      }
    },
    "quizOption": {
      "default": {
        "background":   { "value": "{color.base.b2}" },
        "border":       { "value": "{color.border.default}" },
        "color":        { "value": "{color.text.primary}" }
      },
      "correct": {
        "background":   { "value": "{color.pastel.mint.dim}" },
        "border":       { "value": "rgba(168, 240, 208, 0.30)" },
        "color":        { "value": "{color.pastel.mint.base}" }
      },
      "wrong": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "border":       { "value": "rgba(255, 179, 198, 0.25)" },
        "color":        { "value": "{color.pastel.rose.base}" }
      }
    },
    "srsChip": {
      "hot": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "color":        { "value": "{color.pastel.rose.base}" },
        "border":       { "value": "rgba(255, 179, 198, 0.20)" },
        "description":  "Từ cần ôn khẩn cấp"
      },
      "warm": {
        "background":   { "value": "{color.pastel.peach.dim}" },
        "color":        { "value": "{color.pastel.peach.base}" },
        "border":       { "value": "rgba(255, 201, 160, 0.18)" },
        "description":  "Từ cần ôn sớm"
      }
    }
  },

  "animation": {
    "duration": {
      "fast":   { "value": "150ms" },
      "normal": { "value": "250ms" },
      "slow":   { "value": "400ms" }
    },
    "easing": {
      "default":    { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "spring":     { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "description": "Bounce effect for XP toast" },
      "decelerate": { "value": "cubic-bezier(0, 0, 0.2, 1)" }
    }
  }
}