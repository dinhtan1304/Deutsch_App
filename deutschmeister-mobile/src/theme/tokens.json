{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/lib/common/formats/json-schema.json",
  "meta": {
    "project": "Deutschmeister",
    "version": "2.0.0",
    "theme": "Zen Focus Dark Mode",
    "description": "Forest-green dark base với muted earthy accents. Sage green CTA, bamboo accent, muted semantic colors trên nền deep forest night."
  },

  "color": {
    "base": {
      "b0": { "value": "#1A2421", "description": "App background - Deep Forest Night" },
      "b1": { "value": "#1F2B27", "description": "Page background" },
      "b2": { "value": "#25332E", "description": "Card / surface - Muted Charcoal-Green" },
      "b3": { "value": "#2D3E38", "description": "Input / nested surface" },
      "b4": { "value": "#354842", "description": "Hover / elevated surface" }
    },
    "pastel": {
      "lime": {
        "base":   { "value": "#8EAD92", "description": "Primary CTA - Muted Sage Green" },
        "dim":    { "value": "rgba(142, 173, 146, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#0a1a0f", "description": "Text on sage fill" }
      },
      "mint": {
        "base":   { "value": "#7BC88C", "description": "Correct state, learned words, noun das" },
        "dim":    { "value": "rgba(123, 200, 140, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#052a1a", "description": "Text on mint fill" }
      },
      "lavender": {
        "base":   { "value": "#B8A9D4", "description": "Level, profile, active tab" },
        "dim":    { "value": "rgba(184, 169, 212, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#1a0a3a", "description": "Text on lavender fill" }
      },
      "sky": {
        "base":   { "value": "#8BB5CF", "description": "Noun der, info" },
        "dim":    { "value": "rgba(139, 181, 207, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#011a2a", "description": "Text on sky fill" }
      },
      "rose": {
        "base":   { "value": "#D4838E", "description": "Noun die, wrong state, SRS hot" },
        "dim":    { "value": "rgba(212, 131, 142, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#2a0010", "description": "Text on rose fill" }
      },
      "peach": {
        "base":   { "value": "#D4B483", "description": "XP reward, achievements, SRS warm, Bamboo accent" },
        "dim":    { "value": "rgba(212, 180, 131, 0.10)", "description": "Tinted surface" },
        "on":     { "value": "#2a1000", "description": "Text on peach fill" }
      }
    },
    "semantic": {
      "correct":      { "value": "{color.pastel.mint.base}" },
      "wrong":        { "value": "{color.pastel.rose.base}" },
      "xp":           { "value": "{color.pastel.peach.base}" },
      "level":        { "value": "{color.pastel.lavender.base}" },
      "cta":          { "value": "{color.pastel.lime.base}" },
      "noun-der":     { "value": "{color.pastel.sky.base}" },
      "noun-die":     { "value": "{color.pastel.rose.base}" },
      "noun-das":     { "value": "{color.pastel.mint.base}" }
    },
    "text": {
      "primary":      { "value": "#E1E8E4", "description": "Main text - Mint Silk" },
      "secondary":    { "value": "#8A9D97", "description": "Secondary text (~4.8:1 contrast)" },
      "tertiary":     { "value": "#4A5D57", "description": "Hint / placeholder - Slate Moss" },
      "disabled":     { "value": "#3A4D47" }
    },
    "border": {
      "subtle":       { "value": "rgba(225, 232, 228, 0.06)", "description": "Default card border" },
      "default":      { "value": "rgba(225, 232, 228, 0.10)", "description": "Emphasized border" },
      "strong":       { "value": "rgba(225, 232, 228, 0.18)", "description": "Focus / active border" }
    }
  },

  "typography": {
    "fontFamily": {
      "heading": { "value": "Quicksand", "description": "Heading font" },
      "body": { "value": "Nunito", "description": "Body font" },
      "mono": { "value": "'SF Mono', 'Fira Code', monospace" }
    },
    "fontSize": {
      "xs":   { "value": 11 },
      "sm":   { "value": 13 },
      "base": { "value": 15 },
      "md":   { "value": 17 },
      "lg":   { "value": 20 },
      "xl":   { "value": 26 },
      "word": { "value": 50, "description": "Vocab card big word" },
      "hero": { "value": 64, "description": "Streak hero number" }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 },
      "black":    { "value": 800 }
    },
    "lineHeight": {
      "tight":    { "value": 1.0 },
      "snug":     { "value": 1.3 },
      "normal":   { "value": 1.6 },
      "relaxed":  { "value": 1.7 }
    },
    "letterSpacing": {
      "tight":    { "value": -2 },
      "snug":     { "value": -0.5 },
      "normal":   { "value": 0 },
      "wide":     { "value": 0.5 },
      "widest":   { "value": 1.2, "description": "Uppercase labels" }
    }
  },

  "spacing": {
    "xs":   { "value": 4 },
    "sm":   { "value": 8 },
    "md":   { "value": 12 },
    "lg":   { "value": 16 },
    "xl":   { "value": 20 },
    "2xl":  { "value": 28 },
    "3xl":  { "value": 36 },
    "screen-h": { "value": 16, "description": "Horizontal screen padding" }
  },

  "borderRadius": {
    "sm":    { "value": 8 },
    "md":    { "value": 12 },
    "lg":    { "value": 16 },
    "xl":    { "value": 20 },
    "stone": { "value": 24, "description": "Zen cards and containers" },
    "2xl":   { "value": 24, "description": "Hero cards, word card" },
    "pill":  { "value": 999, "description": "Buttons, badges, nav" }
  },

  "shadow": {
    "zenGlow": { "value": "0 0 20px rgba(142, 173, 146, 0.1)", "description": "Soft sage glow" },
    "float":   { "value": "0 10px 40px rgba(26, 36, 33, 0.3)", "description": "Floating element shadow" }
  },

  "component": {
    "statusBar":    { "height": { "value": 44 } },
    "bottomNav": {
      "height":         { "value": 60 },
      "borderRadius":   { "value": 999 },
      "background":     { "value": "{color.base.b2}" },
      "border":         { "value": "{color.border.default}" },
      "margin":         { "value": "8px 12px 12px" }
    },
    "card": {
      "background":     { "value": "{color.base.b2}" },
      "border":         { "value": "{color.border.default}" },
      "borderRadius":   { "value": "{borderRadius.stone}" },
      "padding":        { "value": "14px 16px" }
    },
    "heroCard": {
      "background":     { "value": "{color.base.b2}" },
      "accentBorder":   { "value": "rgba(142, 173, 146, 0.15)" },
      "borderRadius":   { "value": "{borderRadius.2xl}" },
      "padding":        { "value": "18px 20px" }
    },
    "button": {
      "primary": {
        "background":   { "value": "{color.pastel.lime.base}" },
        "color":        { "value": "{color.pastel.lime.on}" },
        "borderRadius": { "value": "{borderRadius.pill}" },
        "height":       { "value": 50 },
        "fontSize":     { "value": "{typography.fontSize.md}" },
        "fontWeight":   { "value": "{typography.fontWeight.black}" }
      },
      "ghost": {
        "background":   { "value": "{color.base.b2}" },
        "color":        { "value": "{color.text.secondary}" },
        "border":       { "value": "{color.border.default}" },
        "borderRadius": { "value": "{borderRadius.pill}" },
        "height":       { "value": 50 }
      }
    },
    "badge": {
      "genderDer": {
        "background":   { "value": "{color.pastel.sky.dim}" },
        "color":        { "value": "{color.pastel.sky.base}" },
        "border":       { "value": "rgba(139, 181, 207, 0.20)" }
      },
      "genderDie": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "color":        { "value": "{color.pastel.rose.base}" },
        "border":       { "value": "rgba(212, 131, 142, 0.20)" }
      },
      "genderDas": {
        "background":   { "value": "{color.pastel.mint.dim}" },
        "color":        { "value": "{color.pastel.mint.base}" },
        "border":       { "value": "rgba(123, 200, 140, 0.20)" }
      }
    },
    "quizOption": {
      "default": {
        "background":   { "value": "{color.base.b2}" },
        "border":       { "value": "{color.border.default}" },
        "color":        { "value": "{color.text.primary}" }
      },
      "correct": {
        "background":   { "value": "{color.pastel.mint.dim}" },
        "border":       { "value": "rgba(123, 200, 140, 0.30)" },
        "color":        { "value": "{color.pastel.mint.base}" }
      },
      "wrong": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "border":       { "value": "rgba(212, 131, 142, 0.25)" },
        "color":        { "value": "{color.pastel.rose.base}" }
      }
    },
    "srsChip": {
      "hot": {
        "background":   { "value": "{color.pastel.rose.dim}" },
        "color":        { "value": "{color.pastel.rose.base}" },
        "border":       { "value": "rgba(212, 131, 142, 0.20)" },
        "description":  "Từ cần ôn khẩn cấp"
      },
      "warm": {
        "background":   { "value": "{color.pastel.peach.dim}" },
        "color":        { "value": "{color.pastel.peach.base}" },
        "border":       { "value": "rgba(212, 180, 131, 0.18)" },
        "description":  "Từ cần ôn sớm"
      }
    }
  },

  "animation": {
    "duration": {
      "fast":   { "value": "150ms" },
      "normal": { "value": "250ms" },
      "slow":   { "value": "400ms" }
    },
    "easing": {
      "default":    { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "spring":     { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "description": "Bounce effect for XP toast" },
      "decelerate": { "value": "cubic-bezier(0, 0, 0.2, 1)" }
    }
  }
}