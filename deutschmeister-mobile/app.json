{
  "expo": {
    "name": "DeutschMeister",
    "slug": "deutschmeister",
    "version": "1.0.0",
    "scheme": "deutschmeister",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deutschmeister.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DeutschMeister needs microphone access for speaking practice exercises.",
        "NSSpeechRecognitionUsageDescription": "DeutschMeister uses speech recognition for speaking exercises."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "com.deutschmeister.app",
      "permissions": [
        "RECORD_AUDIO",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366F1"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow DeutschMeister to access your microphone for speaking practice."
        }
      ],
      "expo-speech"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
